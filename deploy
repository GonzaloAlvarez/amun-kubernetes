#!/usr/bin/env bash
# amun-kubernetes/deploy — bring up the cluster end to end.
#
# Reuses the `amun` parent venv at ~/Library/Application Support/amun/.venv if
# present (Ansible already installed there). Otherwise creates one alongside.
#
# All steps are idempotent. Re-run any time.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

# Locate (or create) a Python venv with Ansible + requests.
if [[ "$OSTYPE" == darwin* ]]; then
    VENV="${HOME}/Library/Application Support/amun/.venv"
else
    VENV="${HOME}/.local/share/amun/.venv"
fi

if [[ ! -x "${VENV}/bin/python" ]]; then
    echo ">> bootstrapping Python venv at: ${VENV}"
    mkdir -p "$(dirname "${VENV}")"
    python3 -m venv "${VENV}"
    "${VENV}/bin/python" -m pip install --upgrade pip wheel >/dev/null
fi

echo ">> ensuring Python deps in venv"
"${VENV}/bin/python" -m pip install --upgrade -r requirements.txt >/dev/null

ANSIBLE="${VENV}/bin/ansible-playbook"
ANSIBLE_GALAXY="${VENV}/bin/ansible-galaxy"

if [[ ! -x "${ANSIBLE}" ]]; then
    echo "!! ansible-playbook not found in venv — pip install ansible failed?" >&2
    exit 1
fi

echo ">> installing Ansible Galaxy collections"
"${ANSIBLE_GALAXY}" collection install -r requirements.yml >/dev/null

echo ">> running playbook (skips pfsense — that step is interactive; run ./domain.py separately)"
# Pass venv path so pfsense_dns role can call domain.py with the right python.
# Skip 'pfsense' tag by default — domain.py is interactive (prompts for creds).
# Re-run with `./deploy --tags pfsense` after running ./domain.py once manually,
# or just `./domain.py` ad-hoc.
SKIP_TAGS_DEFAULT="--skip-tags pfsense"
if [[ " $* " == *" --tags "* ]] || [[ " $* " == *" --skip-tags "* ]]; then
    SKIP_TAGS_DEFAULT=""    # user is overriding; respect them
fi
"${ANSIBLE}" main.yml -e "amun_venv=${VENV}" ${SKIP_TAGS_DEFAULT} "$@"

# Final hint
KUBECONFIG_PATH="${HOME}/.kube/config-rpid"
if [[ -f "${KUBECONFIG_PATH}" ]]; then
    echo
    echo "✓ cluster is up. Activate kubectl with:"
    echo "    export KUBECONFIG=${KUBECONFIG_PATH}"
    echo
    echo "Next: run \`../amun-longhorn/deploy\` to install storage,"
    echo "then \`kubectl apply -k deployment/\` to bring up the helloworld app."
fi
